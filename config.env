# ===== Server config ======
# HOST
# Where you server is hosted. Your external IP address.
# Default: localhost
# HOST=your-ip-here

# PORT
# Server Port.
# Default: 3000
# PORT=480

# PEER PATH
# PATH to the PeerJS endpoint.
# Defualt: /
# PEER_PATH=/

# SECURE
# Whether or not to use secure connections.
# Default: false
# SECURE=true

# SSL CERT
# Path to ssl cert.
# SSLCERT=path/to/.cert/file

# SSL KEY
# Path to ssl key.
# SSLKEY=path/to/.key/file

# ===== Logging ======
# LOGGING
# Enable logging.
# Default: true
# LOGGING=true

# VERBOSE
# Enable verbose logging.
# Default: false
VERBOSE=true
